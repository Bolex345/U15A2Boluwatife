 /* Base styles */
body {
    background-color: #F2F2F2;
    color: black;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

/* Header styles */
.header {
    background-color: #004aad; /* Blue */
    color: white;
    padding: 70px;
    text-align: center;
    border-bottom: 5px solid #d32f2f; /* Red */
}

/* Back Button Styling */
.back-button {
    display: inline-flex;
    align-items: center;
    background-color: #AD261B; /* Red background */
    color: white;
    padding: 12px 25px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 5px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
    border: none;
    margin-top: 20px;
}

.back-button svg {
    margin-right: 10px;
    width: 20px;
    height: 20px;
    fill: white;
}

.back-button:hover {
    background-color: #004aad; /* Blue background on hover */
    transform: scale(1.05); /* Slightly enlarge on hover */
}

.back-button:active {
    background-color: #003377; /* Darker blue when clicked */
    transform: scale(1); /* Reset size when clicked */
}

/* Footer */
footer {
    background-color: #F2F2F2;
    color: black;
    padding: 20px;
    text-align: center;
    margin-top: 40px;
    font-size: 16px;
}

.footer-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 30px;
}

.footer-column {
    flex: 1;
    min-width: 200px;
}

.footer-column h4 {
    font-size: 16px;
    margin-bottom: 15px;
    font-weight: bold;
}

.footer-column ul {
    list-style: none;
    padding: 0;
}

.footer-column ul li {
    margin-bottom: 10px;
}

.footer-column ul li a {
    color: #333;
    text-decoration: none;
}

.footer-column ul li a:hover {
    text-decoration: underline;
}

.social-icons {
    display: flex;
    justify-content: center;
    margin: 20px 0;
    gap: 15px;
}

.social-icons img {
    width: 30px;
    height: 30px;
}

.footer-bottom {
    text-align: center;
    font-size: 14px;
    color: #666;
    border-top: 1px solid #ccc;
    padding-top: 20px;
}

/* Navigation Container */
.nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: auto;
}

.logo img {
    height: 50px;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
}

.nav-links li {
    position: relative;
}

.nav-links a {
    color: red;
    text-decoration: none;
    font-size: 16px;
    padding: 8px 12px;
}

.nav-links a:hover {
    background-color: #ffffff;
    border-radius: 5px;
}

.nav-icons {
    display: flex;
    gap: 15px;
}

.nav-icons a {
    color: white;
    font-size: 18px;
    text-decoration: none;
}

.nav-icons a:hover {
    color: #fbbc05;
}

/* Navigation Styles */
nav {
    background-color: #eb1d1d;
    padding: 10px 20px;
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
}

nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
}

nav ul li {
    margin: 0 15px;
}

nav a {
    color: #fff;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1em;
}

nav a:hover {
    color: #004aad;
}

/* Text Elements */
h2 {
    color: #004aad; /* Blue */
    font-size: 28px;
    margin-bottom: 15px;
}

h3 {
    color: #d32f2f; /* Red */
    font-size: 22px;
    margin-top: 20px;
}

p {
    font-size: 16px;
    margin-bottom: 15px;
}

/* Cards */
.event-card, .project-card {
    margin-bottom: 20px;
    border: 2px solid blue;
    background-color: #f8f9fa;
}

.card-title {
    color: red;
}

.card {
    padding: 20px;
}

/* Buttons */
.btn-primary,
.btn-secondary {
    background-color: blue;
    border: none;
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.btn-primary:hover,
.btn-secondary:hover {
    background-color: darkblue;
}

/* Checkbox Group */
.checkbox-group {
    display: flex;
    flex-direction: column;
}

.checkbox-group label {
    font-size: 1em;
    color: #555;
}
