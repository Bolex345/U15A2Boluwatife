/* Base Styles */
body {
    font-family: 'Arial', sans-serif;
    background-color: #F2F2F2;
    padding: 0;
    color: #333;
    line-height: 1.6;
    margin: 0;
}

/* Header */
header {
    background-color: #004aad;
    color: white;
    padding: 70px 20px;
    text-align: center;
    border-bottom: 5px solid #d32f2f;
}

header h1 {
    font-size: 40px;
    margin: 0;
}

header p {
    font-size: 20px;
    margin-top: 10px;
}

.container {
    width: 85%;
    max-width: 1200px;
    margin: 40px auto;
    padding: 20px;
}

section {
    margin-bottom: 40px;
}

h2 {
    color: #004aad;
    font-size: 28px;
    margin-bottom: 15px;
}

h3 {
    color: #d32f2f;
    font-size: 22px;
    margin-top: 20px;
}

p {
    font-size: 16px;
    margin-bottom: 15px;
}

.section-header {
    font-size: 20px;
    margin-bottom: 20px;
    font-weight: bold;
}

.card {
    background-color: #fff;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 20px;
    transition: all 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
}

.table-container {
    overflow-x: auto;
    margin-bottom: 20px;
}

/* Navigation Bar */
nav {
    background-color: #eb1d1d;
    padding: 10px 20px;
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
}

nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
}

nav ul li {
    margin: 0 15px;
}

nav a {
    color: #fff;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1em;
}

nav a:hover {
    color: #004aad;
}

/* Tables */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    background-color: #f9f9f9;
    border-radius: 8px;
}

table, th, td {
    border: 1px solid #ddd;
}

th, td {
    padding: 15px;
    text-align: center;
}

th {
    background-color: #004aad;
    color: white;
}

td {
    font-size: 16px;
}

/* Lists */
.fees-list ul {
    list-style-type: none;
    padding: 0;
}

.fees-list li {
    margin-bottom: 10px;
}

.highlight {
    font-weight: bold;
    color: #004aad;
}

.note {
    font-style: italic;
    color: #888;
}

.info-box {
    background-color: #f9f9f9;
    border-left: 5px solid #d32f2f;
    padding: 15px;
    margin-top: 20px;
    font-size: 16px;
}

/* Back Button */
.back-button {
    display: inline-flex;
    align-items: center;
    background-color: #AD261B;
    color: white;
    padding: 12px 25px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 5px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
    border: none;
    margin-top: 20px;
    outline: none;
}

.back-button svg {
    margin-right: 10px;
    width: 20px;
    height: 20px;
    fill: white;
}

.back-button:hover {
    background-color: #004aad;
    transform: scale(1.05);
}

.back-button:active {
    background-color: #003377;
    transform: scale(1);
}

/* Footer */
footer {
    background-color: #F2F2F2;
    color: black;
    padding: 20px;
    text-align: center;
    margin-top: 40px;
    font-size: 16px;
}

.footer-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 30px;
}

.footer-column {
    flex: 1;
    min-width: 200px;
}

.footer-column h4 {
    font-size: 16px;
    margin-bottom: 15px;
    font-weight: bold;
}

.footer-column ul {
    list-style: none;
    padding: 0;
}

.footer-column ul li {
    margin-bottom: 10px;
}

.footer-column ul li a {
    color: #333;
    text-decoration: none;
}

.footer-column ul li a:hover {
    text-decoration: underline;
}

.social-icons {
    display: flex;
    justify-content: center;
    margin: 20px 0;
    gap: 15px;
}

.social-icons img {
    width: 30px;
    height: 30px;
}

.footer-bottom {
    text-align: center;
    font-size: 14px;
    color: #666;
    border-top: 1px solid #ccc;
    padding-top: 20px;
}
